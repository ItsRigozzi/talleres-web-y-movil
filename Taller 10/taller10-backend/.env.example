# Copia este archivo con el nombre .env y cambia los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Clave secreta para firmar los tokens (Taller 9). Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esta-clave

# Tiempo de expiración de los tokens (por ejemplo: 30s, 15m, 1h).
JWT_EXPIRA=1h

# Datos de tu OAuth App de GitHub (Taller 10).
# Se obtienen en GitHub: Settings → Developer settings → OAuth Apps.
GITHUB_CLIENT_ID=pega-aqui-el-client-id
GITHUB_CLIENT_SECRET=pega-aqui-el-client-secret
GITHUB_REDIRECT_URI=http://localhost:8100/auth/github/callback
